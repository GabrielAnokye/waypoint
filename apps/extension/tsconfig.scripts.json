{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist-types/scripts",
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["chrome"],
    "tsBuildInfoFile": "dist-types/scripts/.tsbuildinfo"
  },
  "include": [
