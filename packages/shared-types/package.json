{
  "name": "@waypoint/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dom-snapshot": {
      "import": "./dist/dom-snapshot.js",
      "types": "./dist/dom-snapshot.d.ts",
      "default": "./dist/dom-snapshot.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/shared-types/src/index.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1",
    "zod": "^3.23.8"
  }
}
